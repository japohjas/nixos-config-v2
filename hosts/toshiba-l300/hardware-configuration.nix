# Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
{ config, lib, pkgs, modulesPath, ... }:

{
  imports =
    [ (modulesPath + "/installer/scan/not-detected.nix")
    ];

  boot.initrd.availableKernelModules = [ "uhci_hcd" "ehci_pci" "ahci" "usb_storage" "sd_mod" "sr_mod" ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ ];
  boot.extraModulePackages = [ ];

  # Korvaa näillä nykyiset fileSystems-määritykset hardware-configuration.nix -tiedostossasi

  fileSystems."/" = {
    device = "/dev/disk/by-uuid/ec1ac435-2677-4963-b255-ea9325eb9edb";
    fsType = "btrfs";
    options = [ "subvol=@root" "compress=zstd:1" "noatime" "discard=async" ];
  };

  fileSystems."/btr_pool" = {
    device = "/dev/disk/by-uuid/ec1ac435-2677-4963-b255-ea9325eb9edb";
    fsType = "btrfs";
    options = [ "compress=zstd:1" "noatime" "discard=async" ];
  };

  fileSystems."/home" = {
    device = "/dev/disk/by-uuid/ec1ac435-2677-4963-b255-ea9325eb9edb";
    fsType = "btrfs";
    options = [ "subvol=@home" "compress=zstd:1" "noatime" "discard=async" ];
  };

  fileSystems."/nix" = {
    device = "/dev/disk/by-uuid/ec1ac435-2677-4963-b255-ea9325eb9edb";
    fsType = "btrfs";
    options = [ "subvol=@nix" "compress=zstd:1" "noatime" "discard=async" ];
  };

  fileSystems."/snapshots" = {
    device = "/dev/disk/by-uuid/ec1ac435-2677-4963-b255-ea9325eb9edb";
    fsType = "btrfs";
    options = [ "subvol=@snapshots" "compress=zstd:1" "noatime" "discard=async" ];
  };

  fileSystems."/var/log" = {
    device = "/dev/disk/by-uuid/ec1ac435-2677-4963-b255-ea9325eb9edb";
    fsType = "btrfs";
    options = [ "subvol=@var_log" "compress=zstd:1" "noatime" "discard=async" ]; # "x-initrd.mount" ];
  };

  # 1. Liitetään uusi swap-alimääritys ilman pakkausta ja noatime-optiolla
  fileSystems."/swap" = {
    device = "/dev/disk/by-uuid/ec1ac435-2677-4963-b255-ea9325eb9edb";
    fsType = "btrfs";
    options = [ "subvol=@swap" "noatime" ];
  };

  # 2. Määritellään 4 gigatavun kokoinen swap-tiedosto
  swapDevices = [ {
    device = "/swap/swapfile";
    size = 4 * 1024; # Koko megatavuina (4096 MB = 4 GB)
  } ];

  zramSwap = {
    enable = true;
    priority = 10;
    memoryPercent = 100; # Sallitaan zramin kasvaa tarvittaessa 4 gigatavuun
  };

  # Optimoitu ytimen käyttäytyminen vähäiselle muistille
  boot.kernel.sysctl = {
    "vm.swappiness" = 120;
  };

  boot.tmp = {
    useTmpfs = true;
    tmpfsSize = "100%";
  };


  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.intel.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}
